# Copy to `.env.prod` on the VM (chmod 600), fill in real values.
# `.env.prod` MUST NOT be committed to git.

# Postgres — pick a long random string (`openssl rand -hex 24`).
POSTGRES_PASSWORD=REPLACE_ME

# Auth.js — shared secret for signing session + socket JWTs.
# Generate: `openssl rand -base64 48`. Web and server share this.
NEXTAUTH_SECRET=REPLACE_ME

# Google OAuth Client (Google Cloud Console → APIs & Services → Credentials).
# Authorized JS origin: https://alan-holdem.duckdns.org
# Authorized redirect URI: https://alan-holdem.duckdns.org/api/auth/callback/google
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME

# DuckDNS token (from https://www.duckdns.org after login).
DUCKDNS_TOKEN=REPLACE_ME

# Optional: auto-post each room's settlement to a Google Sheet.
# Leave both blank to disable — room close works fine without this.
# GOOGLE_SHEETS_SA_KEY: the service account's downloaded JSON key,
#   base64-encoded as ONE line (e.g. `base64 -w0 service-account.json`).
# GOOGLE_SHEETS_SPREADSHEET_ID: the target sheet's ID (from its URL,
#   the part between /d/ and /edit). The sheet must be shared with the
#   service account's client_email as Editor.
GOOGLE_SHEETS_SA_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Socket.IO server image. Runs TS directly via tsx to sidestep the workspace
# TS-resolution headache (shared/db are source-referenced via `main: ./src/index.ts`).
# For our scale (friend app) tsx runtime cost is negligible.

FROM node:22-alpine AS base
# Prisma needs openssl at runtime to detect the correct query-engine binary.
RUN apk add --no-cache openssl
RUN corepack enable && corepack prepare pnpm@11.17.0 --activate
WORKDIR /app

# ---- deps ----
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY web/package.json ./web/
COPY server/package.json ./server/
COPY shared/package.json ./shared/
COPY db/package.json ./db/
COPY db/prisma ./db/prisma
RUN pnpm install --frozen-lockfile

# ---- runtime ----
FROM base AS runner
ENV NODE_ENV=production
COPY --from=deps /app /app
COPY shared ./shared
COPY db ./db
COPY server ./server
# Regenerate Prisma client for the alpine/musl target inside this image.
RUN pnpm --filter @holdem/db exec prisma generate --schema=./prisma/schema.prisma
EXPOSE 3001

# `prisma migrate deploy` applies any pending migration files from
# db/prisma/migrations/ in order (E-4b, migrated 2026-10-20 from the
# previous `prisma db push --accept-data-loss` which silently dropped
# columns on any schema drift). Boot the Socket.IO server after
# migrations succeed. Env vars are supplied by docker-compose.
#
# When adding a new schema change: run `prisma migrate dev --name xxx`
# locally to generate a new migration file, review the SQL, commit it,
# and this prod boot will apply it. If a migration fails on prod, the
# server won't start — see DEPLOY.md §schema-changes.
CMD ["sh", "-c", "pnpm --filter @holdem/db exec prisma migrate deploy --schema=./prisma/schema.prisma && pnpm --filter server exec tsx src/index.ts"]

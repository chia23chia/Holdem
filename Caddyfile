# Caddy config — automatic HTTPS via Let's Encrypt.
# Requires DNS `alan-holdem.duckdns.org` → this server's public IP AND
# ports 80/443 reachable from the internet (OCI Security List + host firewall).
# Caddy 2 handles websocket upgrades on reverse_proxy transparently.

alan-holdem.duckdns.org {
  encode zstd gzip

  # Security headers (A-M1 from docs/AUDIT_2026-10-20.md). CSP intentionally
  # omitted — needs per-app tuning for Next.js inline scripts.
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    # Remove server-fingerprinting header.
    -Server
  }

  # Socket.IO endpoint (path preserved).
  reverse_proxy /socket.io/* server:3001

  # Optional server health probe.
  reverse_proxy /health server:3001

  # Everything else → Next.js.
  reverse_proxy web:3000

  log {
    output stdout
    format console
  }
}

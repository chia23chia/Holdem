    "socket.io": "^4.7.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@vitest/ui": "^5.0.5",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vitest": "^5.0.5"

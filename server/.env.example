SERVER_PORT=3001
DATABASE_URL=postgresql://holdem:holdem_dev_password@localhost:5432/holdem
CORS_ORIGIN=http://localhost:3000

# Must match web/.env.local SOCKET_JWT_SECRET — used to verify
# Socket.IO handshake tokens signed by the web app.
SOCKET_JWT_SECRET=change_me_in_production

# Optional: auto-post settlements to a Google Sheet — see .env.prod.example
# at repo root for details. Leave blank to disable.
GOOGLE_SHEETS_SA_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# ============================================================
# Root .env — copy to .env for `docker compose` to pick up
# ============================================================

# PostgreSQL (Docker Compose)
POSTGRES_USER=holdem
POSTGRES_PASSWORD=holdem_dev_password
POSTGRES_DB=holdem
POSTGRES_PORT=5432

# ------------------------------------------------------------
# Per-workspace .env files
# ------------------------------------------------------------
# web/.env.local
#   NEXTAUTH_URL=http://localhost:3000
#   NEXTAUTH_SECRET=change_me_in_production
#   NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
#   GOOGLE_CLIENT_ID=          (Phase 1 fill in)
#   GOOGLE_CLIENT_SECRET=      (Phase 1 fill in)
#
# server/.env
#   SERVER_PORT=3001
#   DATABASE_URL=postgresql://holdem:holdem_dev_password@localhost:5432/holdem
#   CORS_ORIGIN=http://localhost:3000

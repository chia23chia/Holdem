# Auth.js (Phase 1)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_in_production

# Socket.IO handshake JWT — must match server/.env SOCKET_JWT_SECRET.
# Kept separate from NEXTAUTH_SECRET so a leak of either doesn't
# compromise the other channel.
SOCKET_JWT_SECRET=change_me_in_production

# Google OAuth (Phase 1 — leave blank for Phase 0 mock login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Socket.IO server
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

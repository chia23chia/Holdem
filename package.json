{
  "name": "holdem",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --parallel --stream -r --filter=web --filter=server dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "db:generate": "pnpm --filter @holdem/db generate",
    "db:push": "pnpm --filter @holdem/db db:push",
    "db:studio": "pnpm --filter @holdem/db db:studio",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
